[Unit]
Description=Life Organizer (Streamlit)
After=network.target

[Service]
Type=simple
User=lifeorg
Group=lifeorg
WorkingDirectory=/opt/life-organizer
Environment="PATH=/opt/life-organizer/.venv/bin"
ExecStart=/opt/life-organizer/.venv/bin/streamlit run app.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

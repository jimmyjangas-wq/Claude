# Reverse-proxy + basic auth for the Streamlit app.
# Copy to /etc/nginx/sites-available/life-organizer, replace YOUR_DOMAIN,
# then symlink into sites-enabled and reload nginx.

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # Basic auth — see DEPLOY.md for how to generate /etc/nginx/.htpasswd
    auth_basic "Life Organizer";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Streamlit needs websocket upgrades for live updates
    location / {
        proxy_pass         http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 86400;
    }
}

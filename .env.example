# Copy to .env and fill in your values.
LIFE_DOMAIN=life.yourdomain.com
# Generate with:  docker run --rm httpd:alpine htpasswd -nbB james 'YourPassword'
# Then DOUBLE every $ sign (so $2y becomes $$2y) before pasting here.
LIFE_AUTH=james:$$2y$$05$$REPLACE_WITH_REAL_HASH
TRAEFIK_NETWORK=traefik
CERT_RESOLVER=letsencrypt
